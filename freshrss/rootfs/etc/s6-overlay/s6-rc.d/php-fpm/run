#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant App: FreshRSS
# Runs the PHP-FPM daemon
# ==============================================================================

# Execute PHP-FPM
bashio::log.info "Starting php-fpm...."

mkdir -p /config/logs
exec php-fpm83 -R --nodaemonize >> /config/logs/php-fpm.log 2>&1
