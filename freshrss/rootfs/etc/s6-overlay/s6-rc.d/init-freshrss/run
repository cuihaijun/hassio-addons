#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant App: FreshRSS
# Init freshrss
# ==============================================================================

# Initialize persistent log directory on addon_config volume
if ! bashio::fs.directory_exists "/config/logs"; then
    bashio::log.debug 'Creating persistent log directory /config/logs...'
    mkdir -p /config/logs
fi
chmod 755 /config/logs

# Create compatibility path /config/app/68949b71_freshrss/logs
mkdir -p /config/app/68949b71_freshrss
compat_logs="/config/app/68949b71_freshrss/logs"
if [ -L "${compat_logs}" ]; then
    # Symlink already exists; ensure it points to /config/logs
    ln -sfn /config/logs "${compat_logs}"
elif [ -d "${compat_logs}" ]; then
    # Legacy physical directory exists: safely migrate any existing files to /config/logs
    bashio::log.info "Migrating legacy log directory ${compat_logs} to /config/logs..."
    migration_failed=0
    shopt -s nullglob dotglob
    for file in "${compat_logs}"/*; do
        base_name="$(basename "${file}")"
        if [ "${base_name}" = "." ] || [ "${base_name}" = ".." ]; then
            continue
        fi
        base_name="$(basename "${file}")"
        if [ "${base_name}" = "." ] || [ "${base_name}" = ".." ] || [ "${base_name}" = "*" ]; then
            continue
        fi
        dest="/config/logs/${base_name}"
        if [ -e "${dest}" ] || [ -L "${dest}" ]; then
            idx=1
            timestamp="$(date +%s)"
            candidate="/config/logs/${base_name}.migrated_${timestamp}"
            while [ -e "${candidate}" ] || [ -L "${candidate}" ]; do
                candidate="/config/logs/${base_name}.migrated_${timestamp}_${idx}"
                idx=$((idx + 1))
            done
            dest="${candidate}"
        fi
        if ! cp -a "${file}" "${dest}"; then
            bashio::log.error "Failed to copy ${file} to ${dest}; keeping legacy directory intact!"
            migration_failed=1
            break
        fi
    done
    shopt -u nullglob dotglob

    if [ "${migration_failed}" -eq 0 ]; then
        rm -rf "${compat_logs}"
        ln -sf /config/logs "${compat_logs}"
        bashio::log.info "Legacy log directory successfully migrated and replaced with symlink."
    else
        bashio::exit.nok "Aborting FreshRSS initialization due to log migration failure"
    fi
elif [ ! -e "${compat_logs}" ]; then
    ln -sf /config/logs "${compat_logs}"
fi

# Setup data directory
if ! bashio::fs.directory_exists "/data/freshrss"; then
    bashio::log.debug 'Data directory not initialized, doing that now...'

    # Setup structure
    cp -R /usr/share/freshrss/data /data/freshrss
    chown nginx:nginx -R /data/freshrss
fi

# Set base URL
bashio::log.debug "base_url value: '$(bashio::config 'base_url')'"

if ! bashio::fs.file_exists "/data/freshrss/config.php"; then
    bashio::log.debug 'Config file not found. Using default config.'
    bashio::log.debug 'Before modification of /usr/share/freshrss/config.default.php:'
    bashio::log.debug "$(grep base_url /usr/share/freshrss/config.default.php)"

    bashio::log.debug 'Setting URL in default config file...'
    sed -i -E "s|('base_url'\s*=>\s*)'[^']*'|\1'$(bashio::config 'base_url')'|" /usr/share/freshrss/config.default.php

    bashio::log.debug 'After modification of /usr/share/freshrss/config.default.php:'
    bashio::log.debug "$(grep base_url /usr/share/freshrss/config.default.php)"
else
    bashio::log.debug 'Config file found. Using existing config.'
    bashio::log.debug 'Before modification of /data/freshrss/config.php:'
    bashio::log.debug "$(grep base_url /data/freshrss/config.php)"

    bashio::log.debug 'Setting URL in existing config file...'
    sed -i -E "s|('base_url'\s*=>\s*)'[^']*'|\1'$(bashio::config 'base_url')'|" /data/freshrss/config.php

    bashio::log.debug 'After modification of /data/freshrss/config.php:'
    bashio::log.debug "$(grep base_url /data/freshrss/config.php)"
fi

# Ensure /config/extensions exists
if ! bashio::fs.directory_exists "/config/extensions"; then
    bashio::log.debug 'Creating /config/extensions directory...'
    mkdir -p /config/extensions
    chown nginx:nginx /config/extensions

    # Copy existing FreshRSS extensions (if available)
    if [ -d "/usr/share/freshrss/extensions" ]; then
        bashio::log.debug 'Copying default FreshRSS extensions to /config/extensions...'
        cp -Rn /usr/share/freshrss/extensions/* /config/extensions/
        chown -R nginx:nginx /config/extensions
    fi
fi

internal_user_dir="/data/freshrss/users/_"
if ! bashio::fs.directory_exists "${internal_user_dir}"; then
    bashio::log.debug "Creating FreshRSS internal user directory: ${internal_user_dir}"
    mkdir -p "${internal_user_dir}"
fi

touch "${internal_user_dir}/log.txt"
chown -R nginx:nginx "${internal_user_dir}"
